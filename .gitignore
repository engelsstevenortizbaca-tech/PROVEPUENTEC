# ---------------------------------------------
# Dependencias
# ---------------------------------------------
node_modules/
.pnp/
.pnp.js
jspm_packages/

# ---------------------------------------------
# Builds y salidas de compilación
# ---------------------------------------------
dist/
build/
out/
.vite/
client/dist/
server/dist/

# ---------------------------------------------
# Variables de entorno
# ---------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# ---------------------------------------------
# Logs
# ---------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------
# Archivos subidos por usuarios
# ---------------------------------------------
# Almacenamiento local de las imágenes de producto (decisión E). El contenido
# es dato de ejecución, no código: no debe versionarse. Se ignora el contenido
# del directorio, no el directorio, para que `.gitkeep` lo conserve en el
# repositorio y la aplicación encuentre la ruta al arrancar.
server/uploads/*
!server/uploads/.gitkeep

# ---------------------------------------------
# Cachés y temporales
# ---------------------------------------------
.cache/
.temp/
.tmp/
*.tmp
coverage/
.nyc_output/
.eslintcache

# ---------------------------------------------
# Editores e IDEs
# ---------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------
# Sistema operativo
# ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------
# Capacitor / Móvil
# ---------------------------------------------
.capacitor/
android/
ios/

# ---------------------------------------------
# Base de datos (local)
# ---------------------------------------------
*.sqlite
*.sqlite3
*.db
