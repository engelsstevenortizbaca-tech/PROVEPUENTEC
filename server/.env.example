# ==============================================================
# Servidor
# ==============================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# URL pública base (para construir enlaces de correo)
APP_URL=http://localhost:3000
# Saltos de proxy inverso de confianza (0 = ninguno). Actívalo SOLO si hay un
# proxy delante: con un valor > 0 y sin proxy, un cliente puede falsear su IP
# mediante X-Forwarded-For y eludir el rate limiting.
TRUST_PROXY=0

# ==============================================================
# Base de datos (MySQL 8)
# ==============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marketplace
DB_CONNECTION_LIMIT=10

# ==============================================================
# CORS (orígenes separados por coma; * = permitir todos)
# ==============================================================
# En producción NO se admite "*": el servidor no arranca. Indica los orígenes.
CORS_ORIGINS=*

# ==============================================================
# Rate limiting
# ==============================================================
# Límite general de la API.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Límite de los endpoints de autenticación (login, registro, correos).
# Más estricto: es la superficie de fuerza bruta. Solo cuenta los fallos.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# ==============================================================
# Subida de archivos
# ==============================================================
# Directorio de destino (por defecto: server/uploads)
UPLOAD_DIR=
# Ruta pública desde la que se sirven los archivos
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_MAX_FILES=8
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ==============================================================
# Logging (error | warn | info | debug)
# ==============================================================
LOG_LEVEL=info

# ==============================================================
# Autenticación
# ==============================================================
# ¡Cambia estos secretos en producción! Usa cadenas largas y aleatorias.
# En producción son obligatorios, deben medir 32+ caracteres y ser distintos
# entre sí; si no, el servidor aborta el arranque. Para generarlos:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Vida de los tokens de un solo uso (minutos)
PASSWORD_RESET_TTL_MIN=60
EMAIL_VERIFICATION_TTL_MIN=1440
# Si es true, el login exige el correo verificado
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Nombre de la cookie httpOnly del refresh token
REFRESH_COOKIE_NAME=refresh_token
